{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:routeproof:scenario:1",
  "title": "RouteProof scenario schema v1",
  "description": "Structural contract for the YAML/JSON data model accepted by RouteProof.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "model",
    "routers",
    "links",
    "prefixes",
    "events",
    "assertions"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "model": { "const": "ospf_spf_v1" },
    "routers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/router" }
    },
    "links": {
      "type": "array",
      "items": { "$ref": "#/$defs/link" }
    },
    "prefixes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/prefix" }
    },
    "events": {
      "type": "array",
      "items": { "$ref": "#/$defs/event" }
    },
    "assertions": {
      "type": "array",
      "items": { "$ref": "#/$defs/assertion" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "ipv4_prefix": {
      "type": "string",
      "maxLength": 18,
      "pattern": "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}/(?:[1-9]|[12][0-9]|3[0-2])$"
    },
    "router": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "router_id"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "router_id": { "type": "string", "format": "ipv4" },
        "initial_state": { "enum": ["up", "down"], "default": "up" }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "a", "b", "cost_ab", "cost_ba"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "a": { "$ref": "#/$defs/id" },
        "b": { "$ref": "#/$defs/id" },
        "cost_ab": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "cost_ba": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "initial_state": { "enum": ["up", "down"], "default": "up" }
      }
    },
    "prefix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prefix", "origin", "stub_cost"],
      "properties": {
        "prefix": { "$ref": "#/$defs/ipv4_prefix" },
        "origin": { "$ref": "#/$defs/id" },
        "stub_cost": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "seq", "at_ns", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "seq": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
        "at_ns": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
        "type": { "enum": ["link_down", "link_up", "router_down", "router_up"] },
        "link": { "$ref": "#/$defs/id" },
        "router": { "$ref": "#/$defs/id" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "enum": ["link_down", "link_up"] } }, "required": ["type"] },
          "then": { "required": ["link"], "not": { "required": ["router"] } }
        },
        {
          "if": { "properties": { "type": { "enum": ["router_down", "router_up"] } }, "required": ["type"] },
          "then": { "required": ["router"], "not": { "required": ["link"] } }
        }
      ]
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "source", "destination", "quantifier", "scope"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "must_reach" },
        "source": { "$ref": "#/$defs/id" },
        "destination": { "type": "string", "format": "ipv4" },
        "quantifier": { "const": "all" },
        "scope": { "const": "every_snapshot" }
      }
    }
  }
}
