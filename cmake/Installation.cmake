include(GNUInstallDirs)

install(TARGETS routeproof RUNTIME DESTINATION "${CMAKE_INSTALL_BINDIR}")
install(DIRECTORY schemas examples DESTINATION "${CMAKE_INSTALL_DATADIR}/routeproof")
install(DIRECTORY docs DESTINATION "${CMAKE_INSTALL_DOCDIR}")
install(FILES README.md DESTINATION "${CMAKE_INSTALL_DOCDIR}")
install(FILES LICENSE DESTINATION "${CMAKE_INSTALL_DATADIR}/routeproof/licenses")
install(FILES "${yaml-cpp_SOURCE_DIR}/LICENSE"
    DESTINATION "${CMAKE_INSTALL_DATADIR}/routeproof/licenses" RENAME yaml-cpp-LICENSE)
install(FILES "${nlohmann_json_SOURCE_DIR}/LICENSE.MIT"
    DESTINATION "${CMAKE_INSTALL_DATADIR}/routeproof/licenses" RENAME nlohmann-json-LICENSE)
install(FILES "${picosha2_SOURCE_DIR}/LICENSE"
    DESTINATION "${CMAKE_INSTALL_DATADIR}/routeproof/licenses" RENAME PicoSHA2-LICENSE)

string(TOLOWER "${CMAKE_SYSTEM_NAME}" ROUTEPROOF_PACKAGE_SYSTEM)
string(TOLOWER "${CMAKE_SYSTEM_PROCESSOR}" ROUTEPROOF_PACKAGE_PROCESSOR)
if(ROUTEPROOF_PACKAGE_PROCESSOR STREQUAL "aarch64")
    set(ROUTEPROOF_PACKAGE_PROCESSOR arm64)
elseif(ROUTEPROOF_PACKAGE_PROCESSOR STREQUAL "amd64")
    set(ROUTEPROOF_PACKAGE_PROCESSOR x86_64)
endif()
set(CPACK_PACKAGE_NAME routeproof)
set(CPACK_PACKAGE_VERSION "${PROJECT_VERSION}")
set(CPACK_PACKAGE_FILE_NAME
    "routeproof-${PROJECT_VERSION}-${ROUTEPROOF_PACKAGE_SYSTEM}-${ROUTEPROOF_PACKAGE_PROCESSOR}")
set(CPACK_PACKAGE_CHECKSUM SHA256)
set(CPACK_GENERATOR TGZ)
set(CPACK_VERBATIM_VARIABLES YES)
include(CPack)
