{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 2
  },
  "configurePresets": [
    {
      "name": "development",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "ROUTEPROOF_DEFAULT_BUILD_TESTING": {
          "type": "INTERNAL",
          "value": true
        }
      }
    },
    {
      "name": "gcc-debug",
      "displayName": "Debug with GNU GCC",
      "description": "Set ROUTEPROOF_GCC_CXX to the GNU C++ compiler path.",
      "inherits": "development",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "$env{ROUTEPROOF_GCC_CXX}",
        "ROUTEPROOF_EXPECTED_COMPILER_ID": "GNU"
      }
    },
    {
      "name": "clang-debug",
      "displayName": "Debug with upstream Clang",
      "description": "Set ROUTEPROOF_CLANG_CXX to the upstream Clang C++ compiler path.",
      "inherits": "development",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "$env{ROUTEPROOF_CLANG_CXX}",
        "ROUTEPROOF_EXPECTED_COMPILER_ID": "Clang"
      }
    },
    {
      "name": "host-debug",
      "displayName": "Debug with the host C++ compiler",
      "inherits": "development",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-gcc-debug",
      "displayName": "Linux Debug with GCC",
      "inherits": "development",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "g++",
        "ROUTEPROOF_EXPECTED_COMPILER_ID": "GNU"
      }
    },
    {
      "name": "linux-clang-debug",
      "displayName": "Linux Debug with Clang",
      "inherits": "development",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++",
        "ROUTEPROOF_EXPECTED_COMPILER_ID": "Clang"
      }
    },
    {
      "name": "host-sanitizers",
      "displayName": "Host Debug with AddressSanitizer and UndefinedBehaviorSanitizer",
      "inherits": "host-debug",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "host-release",
      "displayName": "Release measurements with the host compiler",
      "inherits": "development",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "gcc-debug",
      "configurePreset": "gcc-debug"
    },
    {
      "name": "clang-debug",
      "configurePreset": "clang-debug"
    },
    {
      "name": "host-debug",
      "configurePreset": "host-debug"
    },
    {
      "name": "linux-gcc-debug",
      "configurePreset": "linux-gcc-debug"
    },
    {
      "name": "linux-clang-debug",
      "configurePreset": "linux-clang-debug"
    },
    {
      "name": "host-sanitizers",
      "configurePreset": "host-sanitizers"
    },
    {
      "name": "host-release",
      "configurePreset": "host-release"
    }
  ]
}
